# 复制为 .env 后填写。留空时自动使用明确标注的“演示批注模式”。
# 官方 OpenAI：使用 Responses API、流式输出和 Structured Outputs。
OPENAI_API_KEY=
AI_MODEL=gpt-5.4-mini

# 兼容服务：取消上方注释并填写。配置 AI_BASE_URL 后自动使用 CompatibleProvider。
# AI_PROVIDER=compatible
# AI_API_KEY=
# AI_BASE_URL=https://example.com/v1

AI_TIMEOUT_MS=45000
# 生产环境必须设置为实际站点；多个来源用英文逗号分隔。
ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
DAILY_AI_CALL_LIMIT=200
DAILY_AI_COST_LIMIT_USD=5
# 默认按 GPT-5.4 Mini 公开价格进行保守预算预留，可按所用模型调整。
AI_INPUT_COST_PER_MILLION=0.75
AI_OUTPUT_COST_PER_MILLION=4.5
# 部署在反向代理之后时设置为 1。
TRUST_PROXY=0
PORT=5173
